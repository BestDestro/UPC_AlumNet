# Copia este fichero a backend/.env (esta ignorado por Git) y rellena los valores.
# NUNCA subas el .env ni compartas las claves por chat, correo o repositorio.

# Clave de cifrado de BLOBs (AES-256): 32 bytes aleatorios en base64. OBLIGATORIA.
# Generala con:
#   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Guardala tambien en un gestor de contrasenas: si se pierde, los documentos cifrados
# NO se pueden recuperar.
BLOB_ENCRYPTION_KEY=

# Rotacion de clave (opcional): claves anteriores en base64 separadas por comas, solo para descifrar.
# BLOB_ENCRYPTION_OLD_KEYS=

# Solo durante la migracion desde el formato antiguo de blobs (transitoria). Mientras queden
# documentos antiguos sin migrar, la app solo puede leerlos si esta definida. Ver
# app/scripts/migrate_blobs.py. Retirala cuando la migracion haya terminado.
# BLOB_LEGACY_KEY=
